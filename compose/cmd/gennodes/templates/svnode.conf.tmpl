{{- /* Generated by compose/cmd/gennodes - DO NOT EDIT */ -}}
# bitcoin.conf for {{ .Name }}: a regtest Bitcoin SV node following the
# teranodes over the legacy protocol (-chaostest). Settings from chaos-test's
# bsv-regtest (cmd/gen).
regtest=1
server=1
listen=1
listenonion=0
dnsseed=0
upnp=0
txindex=1
port=18444
rpcport=18332
rpcbind=0.0.0.0
rpcallowip=127.0.0.1
rpcallowip=10.0.0.0/8
rpcallowip=172.16.0.0/12
rpcallowip=192.168.0.0/16
rpcuser=bitcoin
rpcpassword=bitcoin
rpcthreads=8
rpcworkqueue=200
printtoconsole=1
whitelist=10.0.0.0/8
# post-Genesis consensus limits (same values as teranode's harness)
excessiveblocksize=10GB
maxstackmemoryusageconsensus=100MB
blockmaxsize=4GB
# teranode activates Genesis rules at height 100 on regtest (go-chaincfg); SV Node's default is 10000
genesisactivationheight=100
# Chronicle (splice opcodes): match teranode's go-chaincfg regtest height
chronicleactivationheight=200
minminingtxfee=0.00000001
banscore=1000000
{{- if .Strict }}
# Standard-output policy ON for this node only: a zero-satoshi bare
# "OP_RETURN <data>" output (spendable after Genesis, so dust) is rejected with
# "64: dust", while "OP_FALSE OP_RETURN <data>" is accepted. svnode-dust-policy
# pins the divergence from teranode, which accepts both.
acceptnonstdoutputs=0
{{- end }}
# outbound-only peering: SV Node downloads blocks only from peers it dialled
{{- range .Connect }}
connect={{ . }}
{{- end }}
